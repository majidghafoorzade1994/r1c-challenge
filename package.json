{
  "name": "r1c",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "storybook": "npm run storybook --workspace=@r1c/ui",
    "build-storybook": "npm run build-storybook --workspace=@r1c/ui"
  },
  "devDependencies": {
    "next": "16.2.11",
    "prettier": "^3.7.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "turbo": "^2.9.16",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
