  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/react": "^19",
    "eslint": "^9",
    "typescript": "5.9.2",
    "typescript-eslint": "^8"
  },
  "dependencies": {
    "lucide-react": "1.26.0"
  }
}
